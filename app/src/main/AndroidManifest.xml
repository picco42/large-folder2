<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to query and launch installed apps in home screen folder widgets -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesCondition" />

    <application
        android:name=".FolderWidgetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Main Application Dashboard & Customizer -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating Popup Overlay for full folder apps on home screen -->
        <activity
            android:name=".popup.FolderPopupActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.FolderPopup" />

        <!-- Widget Configuration Activity for when user places widget from launcher -->
        <activity
            android:name=".widget.FolderWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Home Screen Large Folder Widget Provider -->
        <receiver
            android:name=".widget.FolderWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/folder_widget_info" />
        </receiver>

        <!-- Home Screen Large Icon Widget Providers (1x1, 1x2, 2x1) -->
        <receiver
            android:name=".widget.LargeIconWidgetProvider1x1"
            android:exported="true"
            android:label="@string/widget_icon_1x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_icon_widget_info_1x1" />
        </receiver>

        <receiver
            android:name=".widget.LargeIconWidgetProvider1x2"
            android:exported="true"
            android:label="@string/widget_icon_1x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_icon_widget_info_1x2" />
        </receiver>

        <receiver
            android:name=".widget.LargeIconWidgetProvider2x1"
            android:exported="true"
            android:label="@string/widget_icon_2x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_icon_widget_info_2x1" />
        </receiver>

        <!-- Package change receiver to update icons when apps are installed/uninstalled -->
        <receiver
            android:name=".receiver.PackageChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
